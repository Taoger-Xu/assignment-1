# Project OpenAI-compatible endpoint. Copy this file to .env, then insert a
# valid DeepSeek API key locally. Never commit the populated .env file.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=deepseek-flash

# The OpenAI SDK already retries transient failures twice. The harness raises
# this to five by default; override it here only when debugging provider issues.
OPENAI_MAX_RETRIES=5
